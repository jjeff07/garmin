# Copy to  ~/Documents/.ssienv  (a-Shell) or export these before running.
#   python -m garmin_ssi.fit_push dive.fit --env-file .ssienv

# --- MySSI login (required) ---
SSI_EMAIL=you@example.com
SSI_PASSWORD=your-myssi-password
# ...or, instead of email+password, the whole Cookie: header from a logged-in
# my.divessi.com request:
# SSI_COOKIE=PHPSESSID=...; mid=...

# --- identity (required) ---
SSI_USER_ID=4195537          # your MySSI member id (Profile screen)

# --- dive site fallback (used when GPS finds no public site, e.g. a pool) ---
SSI_DIVE_SITE_ID=1018800     # 1018800 North Olmsted Rec Center, 1965 White Star Quarry

# --- optional ---
# SSI_FIRST_NAME=Justin
# SSI_LAST_NAME=Jeffery
# SSI_DIVETYPE_ID=24         # 23 Education, 24 Fun Dive, 138 Scientific, 139 Work
# SSI_COMMENT=Imported from Garmin Descent
# SSI_API_KEY=               # the dive-site locator self-fetches one; only set to override
